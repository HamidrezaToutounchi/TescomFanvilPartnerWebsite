# MongoDB Root Yöneticisi (Sadece ilk kurulum ve yönetim için)
MONGO_ROOT_USER=fanvil_admin
MONGO_ROOT_PASSWORD=BURAYA_GUCLU_ROOT_SIFRESI_YAZIN

# Uygulamaya Özel Kısıtlı Kullanıcı (Sadece 'fanvil' veritabanında readWrite yetkisi vardır)
MONGO_APP_USER=fanvil_app
MONGO_APP_PASSWORD=BURAYA_GUCLU_APP_SIFRESI_YAZIN

# API Servisinin Bağlantı Adresi (MONGO_APP_USER ve MONGO_APP_PASSWORD ile aynı olmalıdır)
MONGO_URI=mongodb://fanvil_app:BURAYA_GUCLU_APP_SIFRESI_YAZIN@fanvil-mongo:27017/fanvil?authSource=fanvil

# Admin Paneli Kalıcı Sistem IP'si (Silinemez VPN / Ofis Çıkış IP'si, virgülle birden fazla yazılabilir)
ADMIN_BOOTSTRAP_IPS=188.124.10.58

# Admin Oturum (Session) İmza Anahtarı (openssl rand -hex 32 ile üretin)
SESSION_SECRET=BURAYA_OPENSSL_RAND_HEX_32_ILE_URETILEN_DEGER_YAZIN

# Mail Sırlarını (Graph Secret / SMTP Şifresi) AES-256-GCM İle Şifrelemek İçin 32-Byte (64 Hex Karakter) Anahtar
SETTINGS_ENC_KEY=BURAYA_OPENSSL_RAND_HEX_32_ILE_URETILEN_64_HEX_YAZIN

# Resmi Site Adresi (Host doğrulaması, CORS ve bildirim maili linkleri için)
PUBLIC_BASE_URL=https://fanvilpartner.com
